[Unit]
Description=Start and stop Yagi recordings

[Service]
Type=oneshot
# The last commit, published by githooks/post-commit. Never the working tree.
# $XDG_DATA_HOME when the session set it, otherwise ~/.local/share.
ExecStart=/bin/sh -c 'exec "${XDG_DATA_HOME:-$HOME/.local/share}/yagi/current/bin/yagi" record due'
