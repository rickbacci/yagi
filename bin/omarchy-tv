#!/usr/bin/env python3
"""
Omarchy TV - Command Line Interface
"""

import os
import sys
import argparse
import json

# Ensure project root is in sys.path (resolving symlinks)
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

from engine.tuner import TunerManager
from engine.scanner import AtscScanner, write_scan_status
from engine.paths import CHANNELS_JSON_PATH, FAVORITES_JSON_PATH
from player.controller import MpvController
from engine.daemon import TvDaemon, send_daemon_request


def cmd_status(args):
    res = send_daemon_request("status")
    if res and res.get("success"):
        print("Omarchy TV Daemon: Running")
        print(f"Player active: {res.get('player_running')}")
        print(f"Channels configured: {res.get('total_channels')}")
        print("\nTuners:")
        for t in res.get("tuners", []):
            status = "BUSY" if t["is_busy"] else "FREE"
            print(f"  [{t['adapter_id']}] {t['name']} ({status}) - Systems: {t['delivery_systems']}")
    else:
        print("Omarchy TV Daemon: Inactive (Running direct hardware query)")
        tuners = TunerManager.list_tuners()
        print(f"Discovered {len(tuners)} tuner adapters:")
        for t in tuners:
            status = "BUSY" if t.is_busy else "FREE"
            print(f"  [{t.adapter_id}] {t.name} ({status}) - Systems: {t.delivery_systems}")


def cmd_scan(args):
    print("=" * 60)
    mode = "Fast Scan (VHF-High + UHF: 30 frequencies)" if args.quick else "Full Scan (All 68 frequencies)"
    print(f"🛰️  Starting ATSC Over-The-Air Scan ({mode})")
    print("=" * 60)

    scanner = AtscScanner(adapter_id=args.adapter)
    found_count = 0

    try:
        for event in scanner.scan(quick_mode=args.quick, timeout_multiplier=args.timeout):
            status = event.get("status")
            if status == "scanning":
                pct = event.get("percent", 0)
                ch = event.get("channel", 0)
                band = event.get("band", "")
                sig = event.get("signal_dbm")
                sig_str = f"{sig:5.1f} dBm" if sig is not None else "Searching..."
                print(f"[{pct:3d}%] Ch {ch:2d} ({band:12s}) | Signal: {sig_str} | Found: {event.get('total_found', 0)}", end="\r")
            elif status == "channel_found":
                found_count += 1
                ch_info = event.get("channel", {})
                print(f"\n  ✨ [FOUND] {ch_info.get('name')} on Physical Ch {ch_info.get('physical_channel')} ({ch_info.get('band')})")
            elif status == "complete":
                print("\n" + "=" * 60)
                print(f"✅ Scan Complete! Discovered {event.get('total_found', 0)} Over-The-Air channels.")
                print(f"Saved to: {CHANNELS_JSON_PATH}")
                print("=" * 60)
    except KeyboardInterrupt:
        write_scan_status({"status": "aborted", "is_scanning": False, "percent": 0})
        print("\n\n⚠️ Scan interrupted by user.")


def cmd_list(args):
    if not os.path.exists(CHANNELS_JSON_PATH):
        print("No channels found. Run `omarchy-tv scan` first!")
        return

    with open(CHANNELS_JSON_PATH, "r") as f:
        data = json.load(f)

    channels = data.get("channels", [])
    print(f"📋 Saved Over-The-Air Channels ({len(channels)} total):")
    print("=" * 75)
    print(f"{'CH':<7} {'NET':<8} {'NAME / CALLSIGN':<32} {'FREQ (MHz)':<12} {'SYS'}")
    print("-" * 75)
    for ch in channels:
        ch_num = ch.get("channel_number") or f"#{ch.get('service_id', '')}"
        net = ch.get("network") or ""
        display = ch.get("display_name") or ch.get("name", "Unknown")
        freq_mhz = f"{ch.get('frequency', 0) / 1000000:.2f}"
        print(f"{ch_num:<7} {net:<8} {display[:32]:<32} {freq_mhz:<12} {ch.get('modulation', '8VSB')}")


def cmd_guide(args):
    from engine.guide import load_guide
    guide = load_guide()
    channels = guide.get("channels", {})
    print("📺 Electronic Program Guide (EPG) — Current Broadcast Schedules:")
    print("=" * 82)
    print(f"{'CH':<6} {'NET':<8} {'CURRENT PROGRAM':<34} {'SCHEDULE':<16} {'NEXT'}")
    print("-" * 82)
    for ch_num, prog in sorted(channels.items(), key=lambda x: float(x[0]) if x[0].replace('.', '', 1).isdigit() else 999):
        net = prog.get("network", "")
        title = prog.get("title", "")[:32]
        times = f"{prog.get('start_time', '')} - {prog.get('end_time', '')}"
        nxt = prog.get("next_title", "")[:20]
        print(f"{ch_num:<6} {net:<8} {title:<34} {times:<16} {nxt}")
    print("=" * 82)


def load_favorites() -> list:
    if os.path.exists(FAVORITES_JSON_PATH):
        try:
            with open(FAVORITES_JSON_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, list):
                    return data
        except Exception:
            pass
    return []


def save_favorites(favorites: list) -> None:
    os.makedirs(os.path.dirname(FAVORITES_JSON_PATH), exist_ok=True)
    tmp = FAVORITES_JSON_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(favorites, f, indent=2)
    os.replace(tmp, FAVORITES_JSON_PATH)


def cmd_favorite(args):
    favs = load_favorites()
    action = args.action or "list"
    target = args.channel

    if action == "list" or not target:
        if not favs:
            print("No favorite channels saved yet.")
            print("Add one with: omarchy-tv favorite toggle <channel_name>")
            return
        print(f"⭐ Favorite Channels ({len(favs)} total):")
        for f in favs:
            print(f"  ★ {f}")
        return

    if action == "add":
        if target not in favs:
            favs.append(target)
            save_favorites(favs)
            print(f"★ Added '{target}' to favorites.")
        else:
            print(f"'{target}' is already in favorites.")
    elif action == "remove":
        if target in favs:
            favs.remove(target)
            save_favorites(favs)
            print(f"Removed '{target}' from favorites.")
        else:
            print(f"'{target}' was not in favorites.")
    elif action == "toggle":
        if target in favs:
            favs.remove(target)
            save_favorites(favs)
            print(f"☆ Removed '{target}' from favorites.")
        else:
            favs.append(target)
            save_favorites(favs)
            print(f"★ Added '{target}' to favorites.")


def cmd_play(args):
    player = MpvController()
    print(f"📺 Tuning to: {args.channel}...")
    success = player.tune(args.channel)
    if not success:
        print("Failed to launch player or tune channel. Is channels.conf generated?")


def cmd_next(args):
    player = MpvController()
    player.channel_up()
    print("Channel Up")


def cmd_prev(args):
    player = MpvController()
    player.channel_down()
    print("Channel Down")


def cmd_stop(args):
    player = MpvController()
    player.stop()
    print("Player stopped")


def cmd_daemon(args):
    daemon = TvDaemon()
    print("Starting Omarchy TV background daemon...")
    daemon.start()


def main():
    parser = argparse.ArgumentParser(description="Omarchy TV - Modern Linux Over-The-Air Television")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # status
    p_status = subparsers.add_parser("status", help="Show tuner and playback status")
    p_status.set_defaults(func=cmd_status)

    # scan
    p_scan = subparsers.add_parser("scan", help="Scan for ATSC broadcast channels")
    p_scan.add_argument("--full", action="store_false", dest="quick", help="Perform full 68-channel scan (default is fast scan)")
    p_scan.add_argument("--adapter", type=int, default=None, help="Specific adapter ID to use")
    p_scan.add_argument("--timeout", type=float, default=1.0, help="Timeout multiplier for signal lock")
    p_scan.set_defaults(func=cmd_scan)

    # list / channels
    p_list = subparsers.add_parser("list", aliases=["channels"], help="List discovered channels")
    p_list.set_defaults(func=cmd_list)

    # guide / epg
    p_guide = subparsers.add_parser("guide", aliases=["epg"], help="Show electronic program guide schedules")
    p_guide.set_defaults(func=cmd_guide)

    # favorite
    p_fav = subparsers.add_parser("favorite", aliases=["fav", "favorites"], help="Manage favorite channels")
    p_fav.add_argument("action", nargs="?", choices=["list", "add", "remove", "toggle"], default="list", help="Action to perform")
    p_fav.add_argument("channel", nargs="?", help="Channel name to favorite")
    p_fav.set_defaults(func=cmd_favorite)

    # play
    p_play = subparsers.add_parser("play", help="Play a channel")
    p_play.add_argument("channel", help="Channel name or callsign to tune")
    p_play.set_defaults(func=cmd_play)

    # next / prev / stop
    subparsers.add_parser("next", help="Tune next channel").set_defaults(func=cmd_next)
    subparsers.add_parser("prev", help="Tune previous channel").set_defaults(func=cmd_prev)
    subparsers.add_parser("stop", help="Close TV player").set_defaults(func=cmd_stop)

    # daemon
    p_daemon = subparsers.add_parser("daemon", help="Run IPC daemon in foreground")
    p_daemon.set_defaults(func=cmd_daemon)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
